            "columns": 1,
            "children": [
              {
                "id": "upper_gauge_pressure",
                "type": "text",
                "label": "Anotar la lectura de presión de este sistema indicada en el manómetro superior del riser",
                "inputMode": "decimal",
                "unit": "PSI"
              },
              {
                "id": "lower_gauge_pressure",
                "type": "text",
                "label": "Anotar la lectura de presión del suministro de agua indicada en el manómetro inferior del riser",
                "inputMode": "decimal",
                "unit": "PSI"
              }
            ]
          },
          {
            "type": "group",
            "id": "flow_alarm_test",
            "label": "Prueba de alarma de flujo",
            "style": "band",
            "columns": 1,
            "children": [
              {
                "id": "flow_sensor_inspected",
                "type": "check",
                "label": "Retirar la tapa del sensor de flujo e inspeccionar, verificar y confirmar que no presenta daño físico visible."
              },
              {
                "id": "flow_sensor_manual",
                "type": "check",
                "label": "Operar en forma manual el mecanismo del sensor de flujo y verificar que opera correctamente."
              },
              {
                "id": "test_drain_flow",
                "type": "check",
                "label": "Generar flujo abriendo la válvula de TEST DRAIN y verificar que el panel detecta flujo con el retardo adecuado."
              },
              {
                "id": "flow_alarm_delay",
                "type": "text",
                "label": "Anotar el valor del retardo de la alarma de flujo de este sistema",
                "inputMode": "numeric",
                "unit": "s"
              },
              {
                "id": "flow_alarm_notification",
                "type": "check",
                "label": "Verificar que las sirenas de notificación y la campana de alarma de flujo correspondiente operan correctamente."
              }
            ]
          }
        ]
      }
    ]
