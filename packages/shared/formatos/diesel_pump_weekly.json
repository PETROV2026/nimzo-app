              "columns": 2,
              "children": [
                {
                  "id": "jockey_start_pressure",
                  "type": "check",
                  "label": "Arranque",
                  "measurement": {
                    "unit": "PSI"
                  }
                },
                {
                  "id": "jockey_stop_pressure",
                  "type": "check",
                  "label": "Paro",
                  "measurement": {
                    "unit": "PSI"
                  }
                }
              ]
            },
            {
              "id": "jockey_2",
              "type": "check",
