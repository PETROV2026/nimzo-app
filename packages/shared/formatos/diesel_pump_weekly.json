              "id": "diesel_1",
              "type": "check",
              "label": "Arranque automático por 30 segundos generando caída de presión."
            },
            {
              "id": "diesel_2",
              "type": "check",
              "label": "Arranque manual de controlador por 30 segundos (cranks 1 y 2)."
            },
            {
              "id": "diesel_3",
              "type": "check",
              "label": "Arranque manual de tablero de instrumentos por 30 segundos (cranks 1 y 2)."
            },
