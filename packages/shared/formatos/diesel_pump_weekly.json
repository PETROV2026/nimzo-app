                    "unit": "PSI"
                  }
                },
                {
                  "id": "run_engine_temperature",
                  "type": "check",
                  "label": "Temperatura del motor",
                  "measurement": {
                    "unit": "°C"
                  }
                },
                {
                  "id": "run_speed",
                  "type": "check",
