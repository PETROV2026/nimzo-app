              "columns": 1,
              "children": [
                {
                  "id": "run_suction_pressure",
                  "type": "check",
                  "label": "Presión de succión de bomba principal",
                  "measurement": {
                    "unit": "PSI"
                  }
                },
                {
                  "id": "run_discharge_pressure",
                  "type": "check",
                  "label": "Presión de descarga de bomba principal",
                  "measurement": {
                    "unit": "PSI"
                  }
                },
                {
                  "id": "run_network_pressure",
                  "type": "check",
                  "label": "Presión en la red hidráulica contra incendios",
                  "measurement": {
                    "unit": "PSI"
                  }
                },
                {
                  "id": "run_bearing_temp_coupling",
                  "type": "check",
                  "label": "Temperatura de balero al lado del acoplamiento",
                  "measurement": {
                    "unit": "°C"
                  }
                },
                {
                  "id": "run_bearing_temp_opposite",
                  "type": "check",
                  "label": "Temperatura de balero al extremo contrario",
                  "measurement": {
                    "unit": "°C"
                  }
                },
                {
                  "id": "run_rpm",
                  "type": "check",
                  "label": "RPM",
                  "measurement": {
                    "unit": "RPM"
                  }
                },
                {
                  "id": "run_motor_temperature",
                  "type": "check",
                  "label": "Temperatura del motor",
                  "measurement": {
                    "unit": "°C"
                  }
                }
              ]
            },
            {
              "type": "group",
              "id": "run_voltage",
              "label": "Volts AC (con carga)",
              "style": "item",
              "columns": 2,
              "children": [
                {
                  "id": "run_voltage_a",
                  "type": "text",
                  "label": "A",
                  "inputMode": "decimal",
                  "unit": "V"
                },
                {
                  "id": "run_voltage_b",
                  "type": "text",
                  "label": "B",
                  "inputMode": "decimal",
                  "unit": "V"
                },
                {
                  "id": "run_voltage_c",
                  "type": "text",
                  "label": "C",
                  "inputMode": "decimal",
                  "unit": "V"
                },
                {
                  "id": "run_voltage_status",
                  "type": "check",
                  "label": "Estado"
                }
              ]
            },
            {
              "type": "group",
              "id": "run_current",
              "label": "Amperes",
              "style": "item",
              "columns": 2,
              "children": [
                {
                  "id": "run_current_a",
                  "type": "text",
                  "label": "A",
                  "inputMode": "decimal",
                  "unit": "A"
                },
                {
                  "id": "run_current_b",
                  "type": "text",
                  "label": "B",
                  "inputMode": "decimal",
                  "unit": "A"
                },
                {
                  "id": "run_current_c",
                  "type": "text",
                  "label": "C",
                  "inputMode": "decimal",
                  "unit": "A"
                },
                {
                  "id": "run_current_status",
                  "type": "check",
                  "label": "Estado"
                }
              ]
            },
            {
              "id": "electric_1",
              "type": "check",
              "label": "Verificar que el sistema no presente ruidos o vibraciones inusuales durante su operación."
            },
            {
              "id": "electric_2",
              "type": "check",
              "label": "Verificar y ajustar lubricación en estoperos."
            },
            {
              "id": "electric_3",
              "type": "check",
              "label": "De no tener habilitado el apagado automático el controlador, al transcurrir los 10 minutos de operación apagar el equipo eléctrico."
            },
            {
              "id": "electric_4",
              "type": "check",
              "label": "Adjuntar una copia de la gráfica de presión y/o historial de eventos impreso."
            },
            {
              "id": "electric_5",
              "type": "check",
              "label": "Encender el sistema eléctrico en modo manual, dejar operando por 15 segundos y apagar mediante el botón de STOP."
            },
            {
              "id": "final_inspection_weekly",
              "type": "check",
              "label": "Realizar inspección general. Restablezca el sistema a su modo de operación automática.",
              "highlight": true
            }
          ]
        }
      ]
    },
    {
      "id": "section_2",
      "title": "Sección 2",
      "children": [
        {
          "type": "note",
          "text": "Las siguientes actividades deben realizarse con el EPP adecuado; existe el riesgo de caída, eléctrico y cortes.",
          "tone": "warning"
        },
        {
          "type": "group",
          "id": "monthly_tests",
          "label": "Pruebas",
          "style": "band",
          "columns": 1,
          "children": [
            {
              "id": "monthly_1",
              "type": "check",
              "label": "Ejercitar cerrando y abriendo las válvulas normalmente abiertas del cuarto de bombas. Cerrar un cuarto de vuelta al final."
            },
            {
              "id": "monthly_2",
              "type": "check",
              "label": "Operar manualmente la válvula de llenado automático del almacenamiento de agua y confirmar que funciona correctamente."
            },
            {
              "id": "monthly_3",
              "type": "check",
              "label": "Probar el interruptor aislador del controlador jockey y verificar que funcione correctamente."
            },
            {
              "id": "monthly_4",
              "type": "check",
              "label": "Activar la protección térmica del controlador jockey utilizando el medio de prueba y verificar que funcione correctamente."
            },
            {
              "id": "monthly_5",
              "type": "check",
              "label": "Realizar limpieza general del cuarto de bombas."
            }
          ]
        }
      ]
    },
    {
      "id": "section_3",
      "title": "Sección 3",
      "children": [
        {
          "type": "group",
          "id": "electric_pump_manual_start",
          "label": "Pruebas a motobomba eléctrica",
          "style": "band",
          "columns": 1,
          "children": [
            {
              "id": "emergency_manual_start",
              "type": "check",
              "label": "Ejercitar los medios manuales de arranque de emergencia (sin carga)."
            }
          ]
        }
      ]
    },
    {
      "id": "section_4",
      "title": "Sección 4",
      "children": [
        {
          "type": "group",
          "id": "annual_inspection",
          "label": "Inspección",
          "style": "band",
          "columns": 1,
          "children": [
            {
              "id": "annual_inspection_1",
              "type": "check",
              "label": "Verificar que no se tenga corrosión en gabinete y componentes en general del controlador eléctrico y jockey."
            },
            {
              "id": "annual_inspection_2",
              "type": "check",
              "label": "Verificar que no se tenga daño en los aislantes eléctricos de los cables y conexiones de las motobombas eléctrica y jockey."
            },
            {
              "id": "annual_inspection_3",
              "type": "check",
              "label": "Verificar que no se tenga humedad en componentes del controlador eléctrico y jockey."
            },
            {
              "id": "annual_inspection_4",
              "type": "check",
              "label": "Verificar que no se tengan daños en canalizaciones y flexibles en cableados de alimentación y conexión a motor de motobombas eléctrica y jockey."
            }
          ]
        },
        {
          "type": "group",
          "id": "annual_maintenance",
          "label": "Mantenimiento",
          "style": "band",
          "columns": 1,
          "children": [
            {
              "id": "annual_maintenance_1",
              "type": "check",
              "label": "Calibración de tazones de bomba jockey usando espaciador suministrado por fábrica."
            },
            {
              "id": "annual_maintenance_2",
              "type": "check",
              "label": "Ajustar las conexiones eléctricas en controlador eléctrico y conexión eléctrica de motor eléctrico y jockey."
            },
            {
              "id": "annual_maintenance_3",
              "type": "check",
              "label": "Calibrar la graduación de los interruptores de presión si éstos se encuentran fuera en un 3% en referencia con equipos de lectura del cuarto de bombas."
            }
          ]
        },
        {
          "type": "group",
          "id": "annual_tests",
          "label": "Pruebas",
          "style": "band",
          "columns": 1,
          "children": [
            {
              "id": "annual_1",
              "type": "check",
              "label": "Activar el sistema de prueba de protección del interruptor o breaker del controlador eléctrico (si existe el mecanismo)."
            },
            {
              "id": "annual_2",
              "type": "check",
              "label": "Con el controlador apagado, activar el mecanismo de arranque de emergencia del controlador eléctrico y verificar utilizando un multímetro la activación de todos los contactores."
            },
            {
              "id": "annual_3",
              "type": "check",
              "label": "Verificar la activación de señales de alarma del controlador eléctrico (bomba operando, controlador apagado y problema general)."
            },
            {
              "id": "annual_4",
              "type": "check",
              "label": "Verificar la alineación entre la bomba y el motor eléctrico. Realizar correcciones en caso necesario."
            },
            {
              "id": "annual_5",
              "type": "check",
              "label": "Para equipos con acoplamiento flexible, verificar que el plástico espaciador del cople no tenga desgaste y se encuentre en buen estado."
            },
            {
              "id": "annual_6",
              "type": "check",
              "label": "Encender el sistema de bombeo eléctrico utilizando los medios manuales de emergencia. Verifique previamente la ausencia de condiciones inseguras."
            },
            {
              "id": "final_inspection_annual",
              "type": "check",
              "label": "Realizar inspección general. Restablezca el sistema a su modo de operación automática.",
              "highlight": true
            }
          ]
        }
      ]
    }
  ]
}
