  "instructions": "Realizar las actividades descritas a continuación. Anotar en ESTADO: OK = Correcto, N/A = No aplica, X = Incorrecto. Anotar la información adicional solicitada donde aplique.",
  "serviceType": {
    "label": "Tipo de servicio",
    "help": "Marque el tipo de servicio y su cobertura. Si el servicio tiene periodicidad ajustada, indique la cobertura aplicable.",
    "allowCustom": true,
    "options": [
      {
        "value": "weekly",
        "label": "Semanal, Sección 1",
        "sections": ["section_1"]
      },
      {
        "value": "monthly",
        "label": "Mensual, Sección 1 y 2",
        "sections": ["section_1", "section_2"]
      },
      {
        "value": "semiannual",
        "label": "Semestral, Sección 1, 2 y 3",
        "sections": ["section_1", "section_2", "section_3"]
      },
      {
        "value": "annual",
        "label": "Anual, Sección 1, 2, 3 y 4",
        "sections": ["section_1", "section_2", "section_3", "section_4"]
      }
    ]
  },
  "sections": [
    {
      "id": "section_1",
      "title": "Sección 1",
      "children": [
        {
          "type": "group",
          "id": "inspections",
          "label": "Inspecciones",
          "style": "band",
          "columns": 1,
          "children": [
            {
              "id": "room_temperature",
              "type": "check",
              "label": "Medir la temperatura del cuarto de bombas. Debe ser mayor a 40 °F (5 °C).",
              "measurement": {
                "unit": "°C"
              }
            },
            {
              "id": "inspection_2",
              "type": "check",
              "label": "La ventilación del cuarto de bombas es adecuada."
            },
            {
              "id": "inspection_3",
              "type": "check",
              "label": "Verificar que la válvula de succión y descarga de la bomba jockey se encuentren totalmente abiertas."
            },
            {
              "id": "inspection_4",
              "type": "check",
              "label": "Verificar que la válvula de succión y descarga de la bomba principal se encuentren totalmente abiertas."
            },
            {
              "id": "inspection_5",
              "type": "check",
              "label": "Verificar el estado correcto de las válvulas restantes en el cuarto de bombas."
            },
            {
              "id": "inspection_6",
              "type": "check",
              "label": "Las válvulas del cuarto de bombas cuentan con candado de seguridad o están eléctricamente supervisadas (según aplique)."
            },
            {
              "id": "inspection_7",
              "type": "check",
              "label": "Las válvulas del cuarto de bombas están identificadas y cuentan con un indicador del sistema o porción del sistema que controlan."
            },
            {
              "id": "inspection_8",
              "type": "check",
              "label": "Las válvulas del cuarto de bombas se encuentran accesibles."
            },
            {
              "id": "inspection_9",
              "type": "check",
              "label": "Verificar fugas en tuberías y mangueras del sistema de bombeo."
            },
            {
              "id": "inspection_10",
              "type": "check",
              "label": "Verificar la ausencia de daño físico en el sistema de bombeo."
            },
            {
              "id": "suction_pressure",
              "type": "check",
              "label": "Presión de succión de bomba principal.",
              "measurement": {
                "unit": "PSI"
              }
            },
            {
              "id": "network_pressure",
              "type": "check",
              "label": "Presión de la red hidráulica contra incendio.",
              "measurement": {
                "unit": "PSI"
              }
            },
            {
              "id": "suction_water_level",
              "type": "check",
              "label": "Nivel de agua en la succión (almacenamiento).",
              "measurement": {}
            },
            {
              "id": "inspection_14",
              "type": "check",
              "label": "El exterior del almacenamiento de agua está libre de daño físico."
            },
            {
              "id": "inspection_15",
              "type": "check",
              "label": "Las anclas del tanque de almacenamiento de agua están en buen estado."
            },
            {
              "id": "inspection_16",
              "type": "check",
              "label": "Los barandales y las escaleras del tanque de almacenamiento de agua están en buen estado."
            },
            {
              "id": "inspection_17",
              "type": "check",
              "label": "El área circundante del almacenamiento de agua está libre de obstrucciones."
            },
            {
              "id": "inspection_18",
              "type": "check",
              "label": "Ejercitar el medidor de nivel del tanque de almacenamiento de agua verificando que no esté atorado."
            },
            {
              "id": "inspection_19",
              "type": "check",
              "label": "La luz piloto indicadora de controlador operativo está encendida."
            },
            {
              "id": "inspection_20",
              "type": "check",
              "label": "Las luces indicadoras de alarma y falla del controlador eléctrico se encuentran apagadas."
            },
            {
              "id": "inspection_21",
              "type": "check",
              "label": "Verificar que el historial del controlador o gráfica de lectura de presión no indiquen ninguna anomalía."
            },
            {
              "id": "inspection_22",
              "type": "check",
              "label": "Verificar que la red hidráulica cuenta con un medio de alivio que permitirá la circulación de agua al operar el equipo de bombeo."
            },
            {
              "id": "inspection_23",
              "type": "check",
              "label": "El nivel de aceite en cabezal de engranes es correcto."
            }
          ]
        },
        {
          "type": "group",
          "id": "general_tests",
          "label": "Pruebas generales",
          "style": "band",
          "columns": 1,
          "children": [
            {
              "type": "group",
              "id": "jockey_voltage_no_load",
              "label": "El suministro de voltaje de AC sin carga del controlador jockey se encuentra dentro del rango adecuado",
