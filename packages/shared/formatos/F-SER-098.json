              "columns": 2,
              "children": [
                {
                  "id": "jockey_voltage_no_load_a",
                  "type": "text",
                  "label": "A",
                  "inputMode": "decimal",
                  "unit": "V"
                },
                {
                  "id": "jockey_voltage_no_load_b",
                  "type": "text",
                  "label": "B",
                  "inputMode": "decimal",
                  "unit": "V"
                },
                {
                  "id": "jockey_voltage_no_load_c",
                  "type": "text",
                  "label": "C",
                  "inputMode": "decimal",
                  "unit": "V"
                },
                {
                  "id": "jockey_voltage_no_load_status",
                  "type": "check",
                  "label": "Estado"
                }
              ]
            },
            {
              "type": "group",
              "id": "jockey_pressures",
              "label": "Provocar una caída de presión en la línea de sensado de la bomba jockey y verificar que el arranque y paro del equipo están en el rango adecuado",
              "style": "item",
              "columns": 2,
              "children": [
                {
                  "id": "jockey_start_pressure",
                  "type": "check",
                  "label": "Valor de presión de arranque",
                  "measurement": {
                    "unit": "PSI"
                  }
                },
                {
                  "id": "jockey_stop_pressure",
                  "type": "check",
                  "label": "Valor de presión de paro",
                  "measurement": {
                    "unit": "PSI"
                  }
                }
              ]
            },
            {
              "id": "jockey_manual_run",
              "type": "check",
              "label": "Encender la bomba jockey en modo manual por 1 minuto y verificar la ausencia de ruidos extraños y calentamiento. Asegurar evitar incremento de presión en la red y mantener una descarga de agua abierta para evitar calentamiento de la bomba. Colocar los equipos de bombeo principales en modo apagado durante esta operación."
            },
            {
              "type": "group",
              "id": "jockey_voltage_load",
              "label": "Verificar que el voltaje de AC con carga de la bomba jockey se mantenga dentro del +/- 10% del valor especificado en placa del controlador de bomba jockey",
              "style": "item",
              "columns": 2,
              "children": [
                {
                  "id": "jockey_voltage_load_a",
                  "type": "text",
                  "label": "A",
                  "inputMode": "decimal",
                  "unit": "V"
                },
                {
                  "id": "jockey_voltage_load_b",
                  "type": "text",
                  "label": "B",
                  "inputMode": "decimal",
                  "unit": "V"
                },
                {
                  "id": "jockey_voltage_load_c",
                  "type": "text",
                  "label": "C",
                  "inputMode": "decimal",
                  "unit": "V"
                },
                {
                  "id": "jockey_voltage_load_status",
                  "type": "check",
                  "label": "Estado"
                }
              ]
            },
            {
              "id": "jockey_short_cycle",
              "type": "check",
              "label": "Provocar una caída de presión instantánea en la línea de sensado del controlador jockey y verificar que no apague y prenda varias veces en unos segundos."
            }
          ]
        },
        {
          "type": "group",
          "id": "electric_pump_tests",
          "label": "Pruebas a motobomba eléctrica",
          "style": "band",
          "columns": 1,
          "children": [
            {
              "id": "main_breaker",
              "type": "check",
              "label": "Ejercitar el interruptor principal (breaker, switch) cerrando y abriendo, verificando que opere correctamente."
            },
            {
              "type": "group",
              "id": "supply_voltage",
              "label": "Con controlador eléctrico apagado, tomar lectura de los voltajes de alimentación y comparar con la lectura de voltaje en controlador. Ambos deben estar dentro del 10% de voltaje de placa del controlador",
              "style": "item",
              "columns": 2,
              "children": [
                {
                  "id": "supply_voltage_a",
                  "type": "text",
                  "label": "A",
                  "inputMode": "decimal",
                  "unit": "V"
                },
                {
                  "id": "supply_voltage_b",
                  "type": "text",
                  "label": "B",
                  "inputMode": "decimal",
                  "unit": "V"
                },
                {
                  "id": "supply_voltage_c",
                  "type": "text",
                  "label": "C",
                  "inputMode": "decimal",
                  "unit": "V"
                },
                {
                  "id": "supply_voltage_status",
                  "type": "check",
                  "label": "Estado"
                }
              ]
            },
            {
              "id": "auto_start_pressure",
              "type": "check",
              "label": "Encender el equipo en modo automático generando una caída de presión en la línea de sensado durante 10 minutos a cero flujo y anotar la presión de arranque.",
              "measurement": {
                "unit": "PSI"
              }
            },
            {
              "id": "running_led",
              "type": "check",
              "label": "Verificar que el controlador confirme marcha mediante el encendido del LED de BOMBA OPERANDO."
            },
            {
              "id": "full_speed_time_check",
              "type": "check",
              "label": "Verificar y anotar el tiempo que toma para alcanzar velocidad plena."
            },
            {
              "id": "first_step_time",
              "type": "check",
              "label": "Verificar el tiempo en que el controlador permanece en el primer paso del arranque. No debe ser más de 5 segundos (para arranque de tensión reducida). Realizar la prueba manteniendo la puerta del controlador cerrada.",
              "measurement": {
                "unit": "s"
              }
            },
            {
              "id": "run_time",
              "type": "check",
              "label": "Verificar el tiempo de operación (para controladores con paro automático)."
            },
            {
              "id": "auto_stop_pressure",
              "type": "check",
              "label": "Registrar la presión de paro programada para paro automático.",
              "measurement": {
                "unit": "PSI"
              }
            },
            {
              "id": "stop_pressure_differential",
              "type": "check",
              "label": "Verificar que la presión de paro automático sea menor que la presión máxima de operación de la bomba, registrar diferencial.",
              "measurement": {
                "unit": "PSI"
              }
            },
            {
              "id": "motor_acceleration_time",
              "type": "check",
              "label": "Verificar el tiempo que toma el motor para acelerar a velocidad plena.",
              "measurement": {
                "unit": "s"
              }
            },
            {
              "type": "group",
              "id": "running_readings",
              "label": "Realizar las siguientes inspecciones durante la operación del equipo. Anotar el valor y su estado",
