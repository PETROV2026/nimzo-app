# Supabase dashboard → Project Settings → API.
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_ANON_KEY=

# Cloudflare dashboard → Turnstile → widget → Site Key (public). The secret key goes in the
# admin-login Edge Function: pnpm supabase secrets set TURNSTILE_SECRET_KEY=...
VITE_TURNSTILE_SITE_KEY=
