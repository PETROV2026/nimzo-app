#!/bin/sh
# Enforce Conventional Commits: <type>(<optional scope>)!: <description>

msg_file="$1"
first_line=$(head -n 1 "$msg_file")

# Allow commits generated by git itself.
case "$first_line" in
  "Merge "* | "Revert "* | "fixup! "* | "squash! "*) exit 0 ;;
esac

pattern='^(feat|fix|docs|style|refactor|perf|test|build|ci|chore|revert)(\([a-z0-9-]+\))?!?: .+'

if ! printf '%s' "$first_line" | grep -Eq "$pattern"; then
  echo "commit-msg: the message does not follow Conventional Commits." >&2
  echo "  Got:      $first_line" >&2
  echo "  Expected: <type>(<scope>): <description>, e.g. 'feat(mobile): add signature capture'" >&2
  echo "  Types:    feat fix docs style refactor perf test build ci chore revert" >&2
  exit 1
fi

exit 0
